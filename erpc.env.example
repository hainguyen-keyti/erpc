# Copy to `.env` next to docker-compose.prod.yml, then fill in. ALL OPTIONAL —
# leave blank to run the gateway on FREE PUBLIC RPC only (keyed providers stay inert).
#   cp erpc.env.example .env

# Envio HyperRPC token (free) — restores the fast eth_getLogs path (HyperRPC now
# requires a token; tokenless => 401 and enumerate falls back to public endpoints).
# Get one: https://app.envio.dev/api-tokens
ENVIO_API_KEY=

# Alchemy free tier — adds eth_simulateV1 + archive on the weak chains AND a reliable
# trusted participant in the consensus quorum. https://dashboard.alchemy.com
ALCHEMY_API_KEY=

# dRPC free tier — a second keyed source (more consensus diversity). https://drpc.org
DRPC_API_KEY=

# REQUIRED — auth is ENABLED in erpc.yaml. Clients authenticate via Basic-auth password
# (https://user:SECRET@host/main/evm/<id>), X-ERPC-Secret-Token header, or ?secret= param.
# If left empty the gateway boots but rejects every remote credential (fail-closed).
# Generate: openssl rand -hex 32
ERPC_AUTH_SECRET=
