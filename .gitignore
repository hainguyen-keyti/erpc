# add relevant .gitignore entries for a Golang project:
vendor/
*.log
*.out
*.pb
*.txt
*.test
*.prof
*.pb.gz
*.pprof
*.cover
coverage.txt
.DS_Store
# erpc.yaml is TRACKED: it holds no secrets (keys come from ${ENV} placeholders) and
# version-control here is what prevents server config drift on redeploy. Keep real
# secrets in .env (ignored below) only.
erpc-*.yaml
erpc.ts
.generated-go-semantic-release-changelog.md
.semrel/
__debug*
node_modules
.next
.env
bin/**
temp/**
erpc-bin
erpc.yml
.claude/**